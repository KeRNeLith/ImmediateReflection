<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <OutputType>Exe</OutputType>

    <!-- Force 64 bits: the SDK default for net48 is x86, which breaks the process generated by BenchmarkDotNet (BadImageFormatException) -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <Title>ImmediateReflection.Benchmark</Title>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>

    <Copyright>Copyright © 2018</Copyright>
    <Description>Benchmark for ImmediateReflection library.</Description>
  </PropertyGroup>

  <!-- Dependencies -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\ImmediateReflection\ImmediateReflection.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$(DeployBuild)">
    <PackageReference Include="StrongNamer" Version="0.2.5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.4" />
    <PackageReference Include="fasterflect" Version="3.0.0" />
    <PackageReference Include="FastMember.Signed" Version="1.5.0" />
    <PackageReference Include="FlashReflection" Version="1.0.2" />
    <PackageReference Include="Sigil" Version="5.0.0" />
  </ItemGroup>

  <!-- Override vulnerable transitive dependency (due to TreatWarningsAsErrors related to FlashReflection dependency) -->
  <ItemGroup>
    <PackageReference Include="System.Private.Uri" Version="4.3.2" />
  </ItemGroup>
</Project>